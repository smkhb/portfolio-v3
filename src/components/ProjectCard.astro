---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  tag?: 'h2' | 'h3';
}

const { project, index, tag = 'h3' } = Astro.props;
const { title, description, url, repo, year, tags } = project.data;

const hues = [235, 190, 330, 25, 265, 155];
const h = hues[index % hues.length];
const Tag = tag;
---

<li
  class="reveal card"
  style={`--h: ${h}; --delay: ${(index % 3) * 0.08}s`}
>
  <div class="flex items-baseline justify-between gap-4">
    <Tag class="text-lg font-bold tracking-tight">
      {url ? <a href={url}>{title}</a> : title}
    </Tag>
    <span class="font-mono text-xs text-soft">{year}</span>
  </div>

  <p class="mt-2 text-sm leading-relaxed text-soft">{description}</p>

  <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-2 font-mono text-xs">
    <span class="dot size-2.5 shrink-0 rounded-full" aria-hidden="true"></span>
    {
      tags.map((t) => (
        <span class="rounded-full bg-mark px-2 py-0.5 text-ink">{t}</span>
      ))
    } 
    {
      repo && (
        <a href={repo} class="ml-auto" target="_blank" rel="noopener noreferrer">
          code
        </a>
      )
    }
  </div>
</li>

<style>
  .card {
    border: 1px solid var(--c-line);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .card:hover {
    border-color: oklch(60% 0.15 var(--h));
    transform: translateY(-2px);
    box-shadow: 0 6px 18px oklch(20% 0.05 var(--h) / 0.12);
  }
  .dot {
    background: var(--c-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: hue 8s linear infinite;
    }
  }
  @keyframes hue {
    to {
      filter: hue-rotate(360deg);
    }
  }
</style>
