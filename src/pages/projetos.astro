---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projetos = (await getCollection('projetos')).sort((a, b) => b.data.year - a.data.year);
---

<Base title="Projetos — Samuel Bernardo" description="Projetos que eu construí, mantengo ou contribuí.">
  <header class="pt-16 pb-10">
    <h1 class="text-[clamp(2.2rem,6vw,3.2rem)] font-extrabold leading-tight tracking-tight">Projetos</h1>
    <p class="mt-4 max-w-[58ch] leading-relaxed text-soft">
      O que eu já construí, do mais recente para o mais antigo.
    </p>
  </header>

  <ul class="border-t border-line">
    {
      projetos.map((p) => (
        <li class="border-b border-line py-7">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-xl font-bold tracking-tight">
              {p.data.url ? (
                <a href={p.data.url} class="hover:text-accent hover:underline underline-offset-4">
                  {p.data.title}
                </a>
              ) : (
                p.data.title
              )}
            </h2>
            <span class="font-mono text-xs text-soft">{p.data.year}</span>
          </div>
          <p class="mt-2 leading-relaxed text-soft">{p.data.description}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {p.data.tags.map((tag) => (
              <span class="rounded-full bg-mark px-2.5 py-0.5 font-mono text-xs text-ink">{tag}</span>
            ))}
          </div>
          {(p.data.url || p.data.repo) && (
            <p class="mt-3 font-mono text-xs">
              {p.data.url && (
                <a href={p.data.url} class="text-accent underline underline-offset-[3px] hover:opacity-80">
                  acessar
                </a>
              )}
              {p.data.url && p.data.repo && <span class="text-soft">{'   '}</span>}
              {p.data.repo && (
                <a href={p.data.repo} class="text-accent underline underline-offset-[3px] hover:opacity-80">
                  código
                </a>
              )}
            </p>
          )}
        </li>
      ))
    }
  </ul>
</Base>
