---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projetos = (await getCollection('projetos')).sort((a, b) => b.data.year - a.data.year);
---

<Base title="Projetos — Samuel Bernardo" description="Projetos que eu construí, mantengo ou contribuí.">
  <header class="sobe pt-16 pb-10">
    <h1 class="text-[clamp(2rem,5.5vw,2.8rem)] font-bold leading-tight tracking-tight">Projetos</h1>
    <p class="sobe sobe-2 mt-4 max-w-[58ch] text-soft">
      O que eu já construí, do mais recente para o mais antigo.
    </p>
  </header>

  <ul class="space-y-5 pb-4">
    {projetos.map((p, i) => <ProjectCard projeto={p} index={i} tag="h2" />)}
  </ul>
</Base>
