---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Samuel Bernardo" description="This page does not exist.">
  <section class="rise py-24 text-center">
    <p class="font-mono text-sm text-soft">error 404</p>
    <h1 class="rise rise-2 mt-3 text-4xl font-bold tracking-tight">Page not found</h1>
    <p class="rise rise-3 mx-auto mt-4 max-w-[46ch] leading-relaxed text-soft">
      The address you opened does not exist or has moved.
    </p>
    <p class="mt-8">
      <a
        class="rounded-md px-5 py-2.5 font-bold transition-opacity hover:opacity-85"
        href="/"
      >
        Back to home
      </a>
    </p>
  </section>
</Base>
