---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada — Samuel Bernardo" description="Essa página não existe.">
  <section class="py-24 text-center">
    <p class="font-mono text-sm text-soft">erro 404</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight">Página não encontrada</h1>
    <p class="mx-auto mt-4 max-w-[46ch] leading-relaxed text-soft">
      O endereço que você abriu não existe ou mudou de lugar.
    </p>
    <p class="mt-8">
      <a
        class="rounded-md bg-ink px-5 py-2.5 font-medium text-paper transition-opacity hover:opacity-85"
        href="/"
      >
        Voltar para a home
      </a>
    </p>
  </section>
</Base>
