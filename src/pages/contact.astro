---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';
---

<Base title="Contact — Samuel Bernardo" description="How to reach me: email and social links.">
  <header class="rise pt-16 pb-10">
    <h1 class="text-[clamp(2.2rem,6vw,3.2rem)] font-bold leading-tight tracking-tight">Contact</h1>
    <p class="rise rise-2 mt-4 max-w-[58ch] leading-relaxed text-soft">
      Got a project in mind, a question, or just want to say hi? Write to me. I'm happy to reply.
    </p>
  </header>

  <section class="reveal mt-2" style="--delay: 0.07s">
    <p class="font-mono text-xs text-soft">email</p>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <a
        class="break-all text-xl font-bold tracking-tight underline underline-offset-[5px]"
        href={`mailto:${SITE.email}`}
      >
        {SITE.email}
      </a>
      <button
        id="copy"
        type="button"
        data-email={SITE.email}
        class="cursor-pointer rounded-md border border-line px-3 py-1.5 font-mono text-xs transition-colors hover:border-accent hover:text-accent"
      >
        Copy email
      </button>
    </div>
  </section>

  <section class="reveal mt-12" style="--delay: 0.14s">
    <p class="font-mono text-xs text-soft">socials</p>
    <ul class="mt-2 divide-y divide-line border-y border-line">
      {
        SITE.socials.map((s) => (
          <li>
            <a href={s.url} class="flex items-baseline justify-between py-3 group" target="_blank" rel="noopener noreferrer">
              <span class="font-bold tracking-tight">{s.label}</span>
              <span class="font-mono text-xs text-soft">{s.url.replace(/^https?:\/\//, '')}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  const button = document.getElementById('copy');
  button?.addEventListener('click', async () => {
    const email = button.getAttribute('data-email') ?? '';
    await navigator.clipboard.writeText(email);
    button.textContent = 'Copied!';
    setTimeout(() => (button.textContent = 'Copy email'), 2000);
  });
</script>
