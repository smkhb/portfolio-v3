---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { dataLonga } from '../lib/datas';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const todos = (await getCollection('projetos')).sort((a, b) => b.data.year - a.data.year);
const destaques = todos.filter((p) => p.data.featured);
const emDestaque = (destaques.length ? destaques : todos).slice(0, 4);
---

<Base title="Samuel Bernardo — bio">
  <section class="pt-14 pb-10">
    <img
      src="/profile.jpeg"
      alt="Foto de perfil de Samuel Bernardo"
      width="112"
      height="112"
      class="sobe size-24 rounded-full object-cover ring-1 ring-line sm:size-28"
    />
    <h1 class="sobe sobe-2 mt-7 text-[clamp(1.9rem,6vw,3rem)] leading-tight font-bold tracking-tight">
      Samuel Bernardo
    </h1>
    <p class="sobe sobe-3 mt-4 max-w-[58ch] text-[1.05rem] text-soft">
      Desenvolvedor. Construo coisas simples que funcionam, da primeira linha de código ao deploy.
    </p>
  </section>

  <section class="space-y-5 text-[1.05rem]">
    <div class="sobe sobe-3">
      <p>
        Prazer, eu sou o Samuel. Trabalho com a web e gosto de resolver problemas com a menor
        quantidade de movimentos possível: código direto, manutenção fácil, sem firula.
      </p>
      <p class="mt-4">
        Este site é a minha casa na internet: nele eu guardo
        <a href="/projetos">o que já construí</a>,
        <a href="/servicos">como posso ajudar</a> e
        <a href="/blog">o que ando escrevendo</a>.
      </p>
      <p class="mt-4">
        Fora do código: [escreva aqui um interesse seu — música, café, corrida, o que for].
      </p>
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-xl font-bold tracking-tight">Projetos</h2>
    <ul class="mt-6 space-y-5">
      {emDestaque.map((p, i) => <ProjectCard projeto={p} index={i} />)}
    </ul>
    <p class="mt-5 font-mono text-xs">
      <a href="/projetos">ver todos os projetos</a>
    </p>
  </section>

  <section class="mt-16">
    <h2 class="text-xl font-bold tracking-tight">Últimos posts</h2>
    <ul class="mt-6 divide-y divide-line border-y border-line">
      {
        posts.map((post) => (
          <li class="py-4">
            <a href={`/blog/${post.id}`} class="block!">
              <span class="font-mono text-xs text-soft">{dataLonga(post.data.pubDate)}</span>
              <span class="mt-1 block font-bold tracking-tight">{post.data.title}</span>
              <span class="mt-1 block text-sm text-soft">{post.data.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-5 font-mono text-xs">
      <a href="/blog">ver todos os posts</a>
    </p>
  </section>
</Base>
