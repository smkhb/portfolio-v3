---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { longDate } from '../lib/dates';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year).slice(0, 2);
---

<Base title="Samuel Bernardo — bio">
  <section class="pt-14 pb-10">
    <button
      type="button"
      class="coin-wrap rise cursor-pointer rounded-full"
      aria-label="Samuel Bernardo profile picture"
    >
      <span class="coin">
        <img
          src="/profile.jpeg"
          alt="Samuel Bernardo profile picture"
          width="112"
          height="112"
          class="face object-cover ring-1 ring-line"
        />
        <span class="face back" aria-hidden="true"></span>
      </span>
    </button>
    <h1 class="rise rise-2 mt-7 text-[clamp(1.9rem,6vw,3rem)] leading-tight font-bold tracking-tight">
      Samuel Bernardo
    </h1>
    <p class="rise rise-3 mt-4 max-w-[58ch] text-[1.05rem] text-soft italic">
      Software developer. I build things that work, from the first line of code to deploy.
    </p>
  </section>

  <section class="space-y-5 text-[1.05rem]">
    <div class="rise rise-3">
      <p>
        Nice to meet you, I'm Sam. I work on the web and like solving problems: straightforward code, easy maintenance, no fluff.
      </p>
      <p class="mt-4">
     Here's is the place where you can find information about me and my work. Here I show{" "}
        <a href="/projects">what I have built</a>,{" "}
        <a href="/services">how I can help</a> and{" "}
        <a href="/blog">what I have been writing</a>.
      </p>
      <p class="mt-4">
       About me: I like to read fiction, philosophy and classical literature. I also enjoy watching La Liga, NBA, Anime and Movies.
      </p>
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-xl font-bold tracking-tight">Projects</h2>
    <ul class="mt-6 space-y-5">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </ul>
    <p class="mt-5 font-mono text-xs">
      <a href="/projects">see all projects</a>
    </p>
  </section>

  <section class="mt-16 pb-8">
    <h2 class="text-xl font-bold tracking-tight">Latest posts</h2>
    <ul class="mt-6 divide-y divide-line border-y border-line">
      {
        posts.map((post) => (
          <li class="py-4">
            <span class="font-mono text-xs text-soft">{longDate(post.data.pubDate)}</span>
            <a href={`/blog/${post.id}`} class="mt-1 block w-fit font-bold tracking-tight">
              {post.data.title}
            </a>
            <span class="mt-1 block text-sm text-soft">{post.data.description}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-5 font-mono text-xs">
      <a href="/blog">see all posts</a>
    </p>
  </section>
</Base>

<script>
  const botao = document.querySelector('.coin-wrap');
  const coin = botao?.querySelector('.coin');
  botao?.addEventListener('click', () => {
    coin?.classList.remove('spinning');
    coin?.classList.add('spinning');
  });
  coin?.addEventListener('animationend', () => coin.classList.remove('spinning'));
</script>
