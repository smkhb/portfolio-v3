---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year);
---

<Base lang="pt-BR" title="Projetos — Samuel Bernardo" description="Projetos que construí, mantive ou nos quais contribuí.">
  <header class="rise pt-16 pb-10">
    <h1 class="text-[clamp(2rem,5.5vw,2.8rem)] font-bold leading-tight tracking-tight">Projetos</h1>
    <p class="rise rise-2 mt-4 max-w-[58ch] text-soft">
      Aqui está parte do trabalho que construí, mantive ou no qual contribuí.
    </p>
  </header>

  <ul class="space-y-5 pb-4">
    {projects.map((p, i) => <ProjectCard project={p} index={i} tag="h2" lang="pt-BR" />)}
  </ul>
</Base>
