---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { dataLonga } from '../lib/datas';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const porAno = new Map<number, typeof posts>();
for (const post of posts) {
  const y = post.data.pubDate.getFullYear();
  if (!porAno.has(y)) porAno.set(y, []);
  porAno.get(y)!.push(post);
}
---

<Base title="Blog — Samuel Bernardo" description="Posts sobre código, web e o que eu ando aprendendo.">
  <header class="pt-16 pb-10">
    <h1 class="text-[clamp(2.2rem,6vw,3.2rem)] font-extrabold leading-tight tracking-tight">Blog</h1>
    <p class="mt-4 max-w-[58ch] leading-relaxed text-soft">
      Anotações sobre código, web e o que eu ando aprendendo.
    </p>
  </header>

  {
    [...porAno.entries()].map(([ano, lista]) => (
      <section class="mb-10">
        <h2 class="font-mono text-sm text-soft">{ano}</h2>
        <ul class="mt-3 divide-y divide-line border-y border-line">
          {lista.map((post) => (
            <li class="py-5">
              <a href={`/blog/${post.id}`} class="group block">
                <span class="font-mono text-xs text-soft">{dataLonga(post.data.pubDate)}</span>
                <span class="mt-1 block text-lg font-bold tracking-tight group-hover:text-accent">
                  {post.data.title}
                </span>
                <span class="mt-1 block text-sm leading-relaxed text-soft">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    posts.length === 0 && (
      <p class="text-soft">Nenhum post publicado ainda. Volte logo: o primeiro está a caminho.</p>
    )
  }
</Base>
