---
import Base from '../layouts/Base.astro';

const stack = [
  { name: 'Node.js', use: 'Server-side JavaScript runtime' },
  { name: 'Nest.js', use: 'Framework for building scalable server-side applications' },
  { name: 'Fastify', use: 'Fast, lightweight web framework' },
  { name: 'TypeScript', use: 'End-to-end typing' },
  { name: 'PostgreSQL', use: 'Relational database management system' },
  { name: 'Zod', use: 'Type-safe validation and parsing' },
  { name: 'Next.js', use: 'React framework for server-side rendering and static site generation' },
  { name: 'Astro', use: 'Fast, static websites' },
  { name: 'React', use: 'JavaScript library for building user interfaces' },
  { name: 'Tailwind CSS', use: 'Utility-first CSS framework' },
  { name: 'GitHub Actions', use: 'CI/CD automation' },
  { name: 'Docker', use: 'Containerization platform' },
  { name: 'GitHub', use: 'Code and version control' },
  { name: 'Cloudflare', use: 'Hosting and DNS' },
  { name: 'Figma', use: 'Design and prototypes' },
];
---

<Base title="Stack — Samuel Bernardo" description="The tools I use every day.">
  <header class="rise pt-16 pb-10">
    <h1 class="text-[clamp(2rem,5.5vw,2.8rem)] font-bold tracking-tight">Stack</h1>
    <p class="rise rise-2 mt-4 max-w-[58ch] text-soft">
      The tools I use every day to build things for the web.
    </p>
  </header>

  <ul class="border-t border-dashed border-line pb-4">
    {
      stack.map((tool, i) => (
        <li
          class="reveal flex items-baseline justify-between gap-6 border-b border-dashed border-line py-5"
          style={`--delay: ${Math.min(i * 0.06, 0.3)}s`}
        >
          <span class="font-bold tracking-tight">{tool.name}</span>
          <span class="text-right text-sm text-soft">{tool.use}</span>
        </li>
      ))
    }
  </ul>
</Base>
