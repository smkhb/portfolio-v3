---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';
---

<Base title="Contato — Samuel Bernardo" description="Como falar comigo: e-mail e redes.">
  <header class="pt-16 pb-10">
    <h1 class="text-[clamp(2.2rem,6vw,3.2rem)] font-extrabold leading-tight tracking-tight">Contato</h1>
    <p class="mt-4 max-w-[58ch] leading-relaxed text-soft">
      Tem um projeto em mente, uma dúvida ou só quer dizer oi? Me escreva — respondo e-mails com prazer.
    </p>
  </header>

  <section class="mt-2">
    <p class="font-mono text-xs text-soft">e-mail</p>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <a
        class="break-all text-xl font-bold tracking-tight text-accent underline underline-offset-[5px] hover:opacity-80"
        href={`mailto:${SITE.email}`}
      >
        {SITE.email}
      </a>
      <button
        id="copiar"
        type="button"
        data-email={SITE.email}
        class="cursor-pointer rounded-md border border-line px-3 py-1.5 font-mono text-xs transition-colors hover:border-accent hover:text-accent"
      >
        Copiar e-mail
      </button>
    </div>
  </section>

  <section class="mt-12">
    <p class="font-mono text-xs text-soft">outros canais</p>
    <ul class="mt-2 divide-y divide-line border-y border-line">
      {
        SITE.sociais.map((s) => (
          <li>
            <a href={s.url} class="flex items-baseline justify-between py-3 group">
              <span class="font-semibold tracking-tight group-hover:text-accent">{s.rotulo}</span>
              <span class="font-mono text-xs text-soft">{s.url.replace(/^https?:\/\//, '')}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  const botao = document.getElementById('copiar');
  botao?.addEventListener('click', async () => {
    const email = botao.getAttribute('data-email') ?? '';
    await navigator.clipboard.writeText(email);
    botao.textContent = 'Copiado!';
    setTimeout(() => (botao.textContent = 'Copiar e-mail'), 2000);
  });
</script>
